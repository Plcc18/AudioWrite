# --- Supabase ---
# Project settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key
# Optional. Only needed if your Supabase project still signs user JWTs with the
# legacy shared HS256 secret (Project settings -> JWT Keys -> Legacy JWT Secret).
# New projects sign with an asymmetric key that the API verifies automatically
# via the project's JWKS endpoint — leave this empty in that case.
SUPABASE_JWT_SECRET=

# Project settings -> Database -> Connection string (URI). Use the "Session" pooler
# connection (port 5432 / 6543) so both the API and the worker (possibly on another
# machine) can connect.
DATABASE_URL=postgresql://postgres:your-password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Storage bucket used to store uploaded audio files. Create it in Supabase Storage
# (private bucket) before running the app.
SUPABASE_STORAGE_BUCKET=audio

# --- API ---
MAX_UPLOAD_MB=50
ALLOWED_AUDIO_EXTENSIONS=mp3,m4a,wav,ogg,opus
SIGNED_URL_EXPIRES_SECONDS=3600
# Origens do frontend autorizadas via CORS (separadas por vírgula).
# Inclua a URL de produção na Vercel, ex.: http://localhost:3000,https://meu-app.vercel.app
FRONTEND_ORIGINS=http://localhost:3000

# --- Worker ---
# JSON list of whisper configurations to run for every job. At least 2 entries
# are required so a consensus can be computed. Each item: model, beam_size, temperature.
# Default below uses "small" twice (CPU-friendly). For better accuracy (but slower /
# more RAM) you can use: [{"model":"small","beam_size":5,"temperature":0.0},{"model":"medium","beam_size":5,"temperature":0.0}]
WHISPER_RUNS=[{"model":"small","beam_size":5,"temperature":0.0},{"model":"small","beam_size":1,"temperature":0.4}]
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Vazio = auto-detecção (padrão). Defina "pt" para fixar português em todas as execuções.
WHISPER_LANGUAGE=
WORKER_POLL_INTERVAL_SECONDS=5
AGREEMENT_THRESHOLD=1.0
CONFIDENCE_THRESHOLD=0.6

# --- Diarização de falantes (opcional, ver README "Identificação de falantes") ---
DIARIZATION_ENABLED=true
# Token do Hugging Face (precisa aceitar os termos de uso de
# pyannote/segmentation-3.0 e pyannote/speaker-diarization-3.1 antes).
HF_TOKEN=
DIARIZATION_DEVICE=cpu
