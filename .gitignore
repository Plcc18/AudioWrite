.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Node / Next.js
node_modules/
.next/
out/
coverage/
*.tsbuildinfo

# OS / editor
.DS_Store
*.local
